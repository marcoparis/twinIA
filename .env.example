# Copia in .env e inserisci i valori. Il .env non va mai committato.

OPENAI_API_KEY=sk-...
# MODEL_NAME=gpt-5.4-mini

# Notifiche ntfy.sh quando un visitatore lascia l'email o fa una domanda senza risposta.
# Il topic e' come una password: chi lo conosce puo' leggere le notifiche.
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=
# Lingua dei titoli delle notifiche: it oppure en
# NOTIFY_LANG=it
